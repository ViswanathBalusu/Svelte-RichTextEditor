{
  "name": "@docedit/authority-service",
  "version": "0.0.0",
  "private": true,
  "description": "The authority package behind a network interface for backends not written in JavaScript (05 §10; PRO-103, PRO-107). Phase 4.",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "start": "node src/main.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@docedit/authority": "workspace:*",
    "@docedit/history": "workspace:*",
    "@docedit/model": "workspace:*",
    "@docedit/rules": "workspace:*",
    "prosemirror-model": "1.25.12",
    "prosemirror-transform": "1.12.5"
  }
}
