# Settings of the integration-test environment (FND-010), read by infra/test-env.ps1 and by the
# integration tests. These are test values: every service listens on 127.0.0.1 only, inside a
# throwaway container whose data lives on tmpfs. They protect nothing and are not secrets; never
# reuse them anywhere else. To change a value, set the variable in the environment, or copy this
# file to .env next to it (that file is read after this one and must not be committed).

# Container command line (CLAUDE.md: Podman, overridable).
DOCEDIT_CONTAINER_CLI=podman

# PostgreSQL. The admin role runs migrations and creates test databases; the service role is what
# the document service connects as (no superuser, no BYPASSRLS; BE-011).
DOCEDIT_PG_HOST=127.0.0.1
DOCEDIT_PG_PORT=55432
DOCEDIT_PG_ADMIN_USER=postgres
DOCEDIT_PG_ADMIN_PASSWORD=docedit-test-admin
DOCEDIT_PG_SERVICE_USER=docedit_service
DOCEDIT_PG_SERVICE_PASSWORD=docedit-test-service

# S3-compatible store (Versity S3 Gateway, root account of the gateway).
DOCEDIT_S3_HOST=127.0.0.1
DOCEDIT_S3_PORT=57070
DOCEDIT_S3_REGION=us-east-1
DOCEDIT_S3_ACCESS_KEY=docedit-test
DOCEDIT_S3_SECRET_KEY=docedit-test-secret-key-0000
DOCEDIT_S3_BUCKET=docedit-test

# Export worker image, built from services/export-worker/Containerfile.
DOCEDIT_EXPORT_IMAGE=localhost/docedit-export-worker:test
