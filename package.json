{
  "name": "docedit-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "Monorepo for the <doc-editor> web component, its document service and the DEP protocol. Working names only (SPK-007).",
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "check": "pnpm lint && pnpm typecheck && pnpm deps:check && pnpm test && pnpm build",
    "check:fast": "node scripts/check-parallel.ts",
    "build": "pnpm -r --if-present build",
    "generate": "pnpm -r --if-present generate",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "deps:check": "depcruise packages services apps --config .dependency-cruiser.cjs",
    "test": "vitest run --project node",
    "test:browsers": "vitest run --project browser",
    "test:all": "vitest run",
    "test:e2e": "playwright test",
    "stories:check": "pwsh -NoProfile -File docs/stories/tools/check-stories.ps1",
    "licence:check": "node scripts/licence-gate.ts",
    "pins:check": "node scripts/supply-chain/pin-check.ts",
    "origins:check": "node scripts/supply-chain/origin-check.ts packages/element/dist/lib --package packages/element --exclude bundle-report.json",
    "release:dry-run": "node scripts/release/release.ts --dry-run",
    "notices": "node scripts/third-party-notices.ts",
    "trace": "pwsh -NoProfile -File docs/stories/tools/traceability.ps1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@types/node": "22.20.5",
    "@vitest/browser-playwright": "5.1.0",
    "dependency-cruiser": "18.7.2",
    "eslint": "10.14.0",
    "eslint-plugin-svelte": "3.24.0",
    "fast-check": "4.10.2",
    "globals": "17.14.0",
    "playwright": "1.65.0",
    "prettier": "3.9.10",
    "prettier-plugin-svelte": "4.1.1",
    "svelte": "5.57.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  },
  "license": "Apache-2.0"
}
