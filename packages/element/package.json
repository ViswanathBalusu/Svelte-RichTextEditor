{
  "name": "@docedit/element",
  "version": "0.0.0",
  "private": true,
  "description": "The <doc-editor> custom element with its open shadow root, and the distributable bundle (02 §2, §3).",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./config.schema.json": "./src/config.schema.json"
  },
  "scripts": {
    "build": "node scripts/build.ts",
    "demo": "node demo/build.ts && node demo/serve.ts",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json && tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@docedit/backend-dep": "workspace:*",
    "@docedit/engine": "workspace:*",
    "@docedit/export-latex": "workspace:*",
    "@docedit/layout-kernel": "workspace:*",
    "@docedit/model": "workspace:*",
    "@docedit/protocol": "workspace:*",
    "@docedit/ui": "workspace:*",
    "svelte": "5.57.3"
  },
  "devDependencies": {
    "@angular/compiler": "21.2.26",
    "@angular/core": "21.2.26",
    "@angular/platform-browser": "21.2.26",
    "@axe-core/playwright": "4.14.0",
    "@docedit/backend-mock": "workspace:*",
    "@sveltejs/kit": "3.1.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/react": "19.3.3",
    "@types/react-dom": "19.3.0",
    "katex": "0.19.1",
    "mathlive": "0.111.4",
    "pdfjs-dist": "6.5.438",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "rxjs": "7.8.2",
    "svelte-check": "4.7.8",
    "vite": "8.3.6",
    "vue": "3.5.46"
  }
}
