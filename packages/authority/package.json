{
  "name": "@docedit/authority",
  "version": "0.0.0",
  "private": true,
  "description": "The authority as pure functions: step allow-list, rebase, apply, invariants, range mapping, the permission outcome check, and the room state machine (04, 07, 12 §4). Phase 0: spike S3 (SPK-016).",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./fixtures/*": "./fixtures/*"
  },
  "scripts": {
    "generate": "node scripts/generate.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@docedit/corpus": "workspace:*",
    "@docedit/model": "workspace:*",
    "@docedit/rules": "workspace:*",
    "prosemirror-model": "1.25.12",
    "prosemirror-transform": "1.12.5"
  },
  "devDependencies": {
    "prosemirror-collab": "1.3.1",
    "prosemirror-state": "1.4.4"
  }
}
