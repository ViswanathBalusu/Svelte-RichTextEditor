{
  "corpus": "docedit-corpus",
  "version": 2,
  "fingerprint": "dd2dac5a76f64fc4630dda4fbf4f8bef5efb64666493dedef04259e6041e18b4",
  "history": [
    {
      "version": 1,
      "date": "2026-11-06",
      "fingerprint": "528ab574d427cd6db2a9368e585272c476ab19ad6131c7e31ba2643430d56fc9",
      "change": "First corpus (FND-006): documents of about 1, 20, 100, 300 and 1,000 pages and a one-page form."
    },
    {
      "version": 2,
      "date": "2026-11-06",
      "fingerprint": "dd2dac5a76f64fc4630dda4fbf4f8bef5efb64666493dedef04259e6041e18b4",
      "change": "A footnote holds one paragraph in the FootnoteText style (CDM-001, option B), so every footnote gains a paragraph identifier and the identifiers after it shift; footnote words are counted once; the licence is Apache-2.0 (SPK-007)."
    }
  ],
  "generator": {
    "command": "pnpm --filter @docedit/corpus generate",
    "random": "sfc32, its state filled by splitmix32 from the 32-bit FNV-1a hash of the seed text",
    "note": "Every document is built from its own seeded streams (seed text docedit-corpus/<name>/<stream>); nothing reads the clock or a platform random source."
  },
  "cdm": 1,
  "canonicalFormVersion": 1,
  "licence": {
    "id": "Apache-2.0",
    "statement": "Original material made for this repository by packages/corpus: written by hand in its source files or generated by its seeded generator. It is covered by the project's licence, Apache-2.0, chosen by the project owner on 2026-11-06 (SPK-007). No third-party text, image or data is included."
  },
  "sources": [
    {
      "id": "prose-en",
      "kind": "text",
      "languages": ["en"],
      "description": "English-like prose, headings, list items, captions and table entries assembled by the seeded generator from word lists and sentence patterns.",
      "provenance": "Original: the word lists and patterns were written for this corpus (src/generate/text.ts); the text has no meaning and quotes nothing.",
      "licence": "Apache-2.0"
    },
    {
      "id": "written-en",
      "kind": "text",
      "languages": ["en"],
      "description": "Fixed English passages: titles, notes, typography samples, header and footer text, form labels and the text of the one-page documents.",
      "provenance": "Original: written for this corpus (src/generate/text.ts and src/generate/documents.ts).",
      "licence": "Apache-2.0"
    },
    {
      "id": "written-cjk",
      "kind": "text",
      "languages": ["zh-Hans-CN", "ja-JP", "ko-KR"],
      "description": "Short Chinese, Japanese and Korean sentences about documents and editing, recombined by the seeded generator.",
      "provenance": "Original: written for this corpus (src/generate/text.ts).",
      "licence": "Apache-2.0"
    },
    {
      "id": "math",
      "kind": "math",
      "languages": [],
      "description": "Short LaTeX formulas of textbook identities (sums, integrals, the binomial coefficient, a matrix, cases).",
      "provenance": "Original LaTeX source written for this corpus; the identities themselves are common mathematical facts.",
      "licence": "Apache-2.0"
    },
    {
      "id": "images",
      "kind": "image",
      "languages": [],
      "description": "Tiny PNG images (patterns, a bar chart, a dot, noise) drawn pixel by pixel by the generator.",
      "provenance": "Original: drawn by src/generate/images.ts.",
      "licence": "Apache-2.0"
    }
  ],
  "pageEstimate": {
    "status": "estimated",
    "method": "Line model: the text of each block is converted to lines, lines to fractions of a page of the page setup in force, and the fractions are summed for each run of pages between forced breaks; each run is rounded up to whole pages.",
    "wordsPerLine": 12,
    "linesPerPage": 40,
    "bodyFontSize": 220,
    "rationale": [
      "wordsPerLine: the A4 text block is 451 pt wide; 11 pt serif text sets about 80 to 85 characters per line, and the generated English averages 6 to 7 characters per word with its space. A planning figure, not a measurement.",
      "linesPerPage: the A4 text block is 698 pt high; 11 pt text at 1.15 line spacing has a line pitch of about 15 to 17 pt depending on the line height of the font, about 40 to 45 lines before paragraph spacing; 40 is used. A planning figure, not a measurement.",
      "Words per line and lines per page scale with the column width (page width, margins, columns, indents), the text height and the font size of the paragraph style; a CJK character takes one em.",
      "The space between paragraphs is the larger of the first one's spaceAfter and the second one's spaceBefore (03 §7), in lines of 349 twips (13,958 twips of text height over 40 lines). Inline images taller than a line add their height; footnotes add their lines at the size of FootnoteText.",
      "A table row takes the lines of its fullest cell plus 0.3 lines of padding, or its height when that is fixed; a figure takes its height, half a line and its caption; a display equation takes 1.5 lines plus 1.2 lines per row.",
      "A table of contents takes one line per heading or caption it lists. A page break, pageBreakBefore, or a section break that is not continuous starts a new page."
    ],
    "replacedBy": "Measured page counts from the S4 LaTeX compile (SPK-017), once it reports them; until then every page count in this manifest is an estimate."
  },
