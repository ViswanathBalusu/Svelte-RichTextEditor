{
  "name": "@docedit/ui",
  "version": "0.0.0",
  "private": true,
  "description": "Svelte 5 components of the shell (02 §4; 13 §3). Never imports prosemirror-* (ADR 0003).",
  "type": "module",
  "sideEffects": false,
  "svelte": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "svelte": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./panes/*": {
      "svelte": "./src/panes/*",
      "default": "./src/panes/*"
    },
    "./fill": "./src/shell/fill.ts",
    "./strings": "./src/i18n/strings.ts",
    "./styles/*": "./src/styles/*"
  },
  "scripts": {
    "generate": "node scripts/generate.ts",
    "parity:report": "node scripts/parity-report.ts",
    "a11y:report": "node scripts/a11y-report.ts",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json && svelte-check --tsconfig ./tsconfig.test.json",
    "test:e2e": "playwright test -c playwright.config.ts"
  },
  "dependencies": {
    "svelte": "5.57.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "svelte-check": "4.7.8",
    "vite": "8.3.6"
  }
}
