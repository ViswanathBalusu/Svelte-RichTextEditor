# Settings of the reference host's demo stack (UX-091, BE-005), read by scripts/stack.ps1, by the
# Node scripts of the stack (scripts/lib/stack.ts) and by compose.yaml. These are test values for a
# demonstration on one machine: every service listens on 127.0.0.1 only. They protect nothing, are
# not secrets, and must never be reused. This is not a production deployment. To change a value,
# set it in the environment, or copy this file to .env next to it (that file is not committed).
# Secrets that matter (the host's API key and signing key, the service's token key) are not here:
# scripts/setup.ts generates them into the stack's data directory, marked demo-only.

# Container command line (CLAUDE.md: Podman, overridable).
DOCEDIT_CONTAINER_CLI=podman

# Names of the containers and volumes: <project>-<service>. The ports below do not collide with the
# integration-test environment of infra/ (55432, 57070).
DOCEDIT_DEMO_PROJECT=docedit-demo

# PostgreSQL. The admin role runs migrations; the service role is what the services connect as.
DOCEDIT_DEMO_PG_PORT=56432
DOCEDIT_DEMO_PG_ADMIN_USER=postgres
DOCEDIT_DEMO_PG_ADMIN_PASSWORD=docedit-demo-admin
DOCEDIT_DEMO_PG_DATABASE=docedit
DOCEDIT_DEMO_PG_SERVICE_USER=docedit_service
DOCEDIT_DEMO_PG_SERVICE_PASSWORD=docedit-demo-service

# S3-compatible store (Versity S3 Gateway, root account of the gateway).
DOCEDIT_DEMO_S3_PORT=56470
DOCEDIT_DEMO_S3_REGION=us-east-1
DOCEDIT_DEMO_S3_ACCESS_KEY=docedit-demo
DOCEDIT_DEMO_S3_SECRET_KEY=docedit-demo-secret-key-0000
DOCEDIT_DEMO_S3_BUCKET=docedit-demo

# The document service and the reference host.
DOCEDIT_DEMO_SERVICE_PORT=56480
DOCEDIT_DEMO_SERVICE_ID=docedit-demo-service
DOCEDIT_DEMO_HOST_PORT=56490
# service-minted (POST /tokens) or host-signed (the host's own key); 05 §3.1.
DOCEDIT_DEMO_TOKENS=service-minted
# Lifetime of user tokens in seconds, at most 900 (05 §3.1).
DOCEDIT_DEMO_TOKEN_SECONDS=300

# The export worker's sandbox image, built from services/export-worker/Containerfile.
DOCEDIT_EXPORT_IMAGE=localhost/docedit-export-worker:demo
# On a Windows or macOS host whose Podman machine cannot apply the sandbox's cgroup limits through
# the remote client, the name of the machine to run the sandbox in (services/export-worker,
# container.ts). Empty: the stack uses the running machine when Podman runs in one.
DOCEDIT_PODMAN_MACHINE=
